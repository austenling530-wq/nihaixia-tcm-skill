# ── 应用 ────────────────────────────────────────────────────
APP_SECRET=               # 访问令牌 HMAC 密钥，随便一串长随机字符串（openssl rand -hex 32）
PORT=3000

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:3306/nihaixia

# ── 模型（OpenAI 兼容，默认走中转站） ──────────────────────
AI_API_KEY=               # 必填
AI_BASE_URL=https://api.90087.cn/v1
AI_MODEL=gpt-5.4
# AI_TIMEOUT_MS=120000
# AI_MAX_TOKENS=3000
# AI_PROMPT_PROFILE=full  # full=完整规则(约 6 万字提示词，效果最像倪师) / lite=精简版(便宜)

# ── 知识库 ──────────────────────────────────────────────────
# KNOWLEDGE_DIR=./knowledge

# ── 初始化口令（只在 npm run db:seed 时用） ─────────────────
# INVITE_CODE=
# INVITE_LABEL=默认分享口令
# INVITE_LIMIT=20

# ── 语音播报（豆包 / 火山引擎语音合成，不填则不显示"听"按钮） ──────
# 控制台：https://console.volcengine.com/speech/app  → 创建应用 → 勾选"语音合成大模型"
TTS_APP_ID=
TTS_ACCESS_TOKEN=
# TTS_VOICE=zh_male_qingcang_mars_bigtts   # 擎苍，沉稳男声；其他音色见控制台音色列表
# TTS_SPEED=1.0
# TTS_CACHE_DIR=.cache/tts
