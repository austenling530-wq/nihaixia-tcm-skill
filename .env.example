# ── 应用 ────────────────────────────────────────────────────
APP_SECRET=               # 访问令牌 HMAC 密钥，随便一串长随机字符串（openssl rand -hex 32）
PORT=3000

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:3306/nihaixia

# ── 模型（OpenAI 兼容，默认走中转站） ──────────────────────
AI_API_KEY=               # 必填
AI_BASE_URL=https://api.90087.cn/v1
AI_MODEL=gpt-5.4
# AI_TIMEOUT_MS=120000
# AI_MAX_TOKENS=3000
# AI_PROMPT_PROFILE=full  # full=完整规则(约 6 万字提示词，效果最像倪师) / lite=精简版(便宜)

# ── 知识库 ──────────────────────────────────────────────────
# KNOWLEDGE_DIR=./knowledge

# ── 初始化口令（只在 npm run db:seed 时用） ─────────────────
# INVITE_CODE=
# INVITE_LABEL=默认分享口令
# INVITE_LIMIT=20

# ── 语音播报（豆包 / 火山引擎语音合成，不填则不显示"听语音"按钮） ──────
# 新版控制台：https://console.volcengine.com/speech → API Key 管理 → 创建；应用需勾选"语音合成大模型 字符版"
TTS_API_KEY=
# TTS_VOICE=zh_male_qingcang_mars_bigtts   # 擎苍，沉稳男声；2.0 音色如 zh_male_ruyayichen_uranus_bigtts
# TTS_RESOURCE_ID=seed-tts-1.0             # 2.0 音色用 seed-tts-2.0（不填按音色名自动判断）
# TTS_SPEED=1.0
# TTS_CACHE_DIR=.cache/tts

# ── 客服入口 ──────
# 二维码图片放 public/kefu-qr.png（企业微信"联系我"二维码）；下面是弹窗里的说明文字
KEFU_NOTE=微信扫码或长按识别，添加客服领取口令、续期或反馈问题。
